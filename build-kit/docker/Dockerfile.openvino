# Intel OpenVINO build (x86_64).
ARG OPENVINO_IMAGE=openvino/ubuntu22_dev:2025.1.0
FROM ${OPENVINO_IMAGE}
USER root

ARG ORT_VERSION=v1.23.2
ENV DEBIAN_FRONTEND=noninteractive

# ORT 1.23's OpenVINO EP compiles at C++20 and includes <format> (ov_factory.cc,
# ov_interface.cc); libstdc++ only ships <format> from GCC 13+. This ubuntu22 OpenVINO image
# has GCC 11, so add GCC 13 from the toolchain PPA and build with it (CC/CXX below). Staying
# on 22.04 keeps the openvino bundle's glibc floor at 2.35 like the other groups and dodges
# 24.04's PEP-668 pip block. Downstream: the Intel AppImage must also ship GCC 13's
# libstdc++.so.6 (the EP pulls GLIBCXX_3.4.32 from <format>).
#
# Clean authenticated install first; fall back to tolerant flags if the image's vendor apt
# repo has a stale key / Release (same issue as the ROCm image) -- applied to the PPA too.
RUN PKGS="git python3 python3-pip python3-dev build-essential ninja-build ccache curl ca-certificates patchelf software-properties-common"; \
    if ! { apt-get update && apt-get install -y --no-install-recommends $PKGS; }; then \
       apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::AllowInsecureRepositories=true && \
       apt-get install -y --no-install-recommends --allow-unauthenticated $PKGS; \
    fi; \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test; \
    if ! { apt-get update && apt-get install -y --no-install-recommends gcc-13 g++-13; }; then \
       apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::AllowInsecureRepositories=true && \
       apt-get install -y --no-install-recommends --allow-unauthenticated gcc-13 g++-13; \
    fi; \
    rm -rf /var/lib/apt/lists/*

# Build the C++20 openvino EP with GCC 13 (see above); cmake/ccache pick these up.
ENV CC=gcc-13 CXX=g++-13

RUN pip3 install --no-cache-dir "cmake==3.31.6"

COPY common/build_ort.sh /work/build_ort.sh
COPY VERSIONS.env /work/VERSIONS.env
RUN chmod +x /work/build_ort.sh

# GPU = default device, graph partitioning on (unsupported ops fall back to the
# ORT CPU EP). The app overrides device_type (CPU/NPU/AUTO) at runtime; all
# plugins load dynamically. Valid build values: CPU|GPU|NPU, *_NO_PARTITION,
# NPU_NO_CPU_FALLBACK, AUTO:GPU,CPU, MULTI:..., HETERO:... (plain AUTO is invalid).
ENV ORT_VERSION=${ORT_VERSION} \
    ORT_GROUP=openvino \
    ORT_EP_FLAGS="--use_openvino GPU --use_xnnpack"

WORKDIR /src
ENTRYPOINT ["bash", "-lc", "source /opt/intel/openvino/setupvars.sh && exec /work/build_ort.sh"]
