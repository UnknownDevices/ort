# Intel OpenVINO build (x86_64).
ARG OPENVINO_IMAGE=openvino/ubuntu22_dev:2024.6.0
FROM ${OPENVINO_IMAGE}
USER root

ARG ORT_VERSION=v1.22.0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 python3-pip python3-dev build-essential ninja-build \
      ccache curl ca-certificates patchelf \
   && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "cmake==3.31.6"

COPY common/build_ort.sh /work/build_ort.sh
COPY VERSIONS.env /work/VERSIONS.env
RUN chmod +x /work/build_ort.sh

ENV ORT_VERSION=${ORT_VERSION} \
    ORT_GROUP=openvino \
    ORT_EP_FLAGS="--use_openvino AUTO --use_xnnpack"

WORKDIR /src
ENTRYPOINT ["bash", "-lc", "source /opt/intel/openvino/setupvars.sh && exec /work/build_ort.sh"]
