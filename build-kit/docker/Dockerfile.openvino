# Intel OpenVINO build (x86_64).
#
# Uses the ubuntu24 OpenVINO image, NOT ubuntu22. ORT 1.23's OpenVINO EP needs two things
# Ubuntu 22.04 can't give at once:
#   - C++20 <format> (ov_factory.cc / ov_interface.cc) -> needs GCC 13+ (22.04 has GCC 11).
#   - MLAS cvtfp16Avx.S uses AVX-NE-CONVERT (vcvtneeph2ps) -> needs binutils >= 2.40 to
#     assemble (22.04 has binutils 2.38; GCC 13 enables this MLAS path).
# Ubuntu 24.04 ships GCC 13 + binutils 2.42 by default, satisfying both. Trade-off: this is
# the only group on 24.04, so the Intel bundle's glibc floor is 2.39 (vs 2.35 elsewhere), and
# the Intel AppImage must ship GCC 13's libstdc++.so.6.
ARG OPENVINO_IMAGE=openvino/ubuntu24_dev:2025.1.0
FROM ${OPENVINO_IMAGE}
USER root

ARG ORT_VERSION=v1.23.2
ENV DEBIAN_FRONTEND=noninteractive

# Clean authenticated install first; fall back to tolerant flags if the image's
# vendor apt repo has a stale key / Release (same issue as the ROCm image).
RUN PKGS="git python3 python3-pip python3-dev build-essential ninja-build ccache curl ca-certificates patchelf"; \
    if ! { apt-get update && apt-get install -y --no-install-recommends $PKGS; }; then \
       apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::AllowInsecureRepositories=true && \
       apt-get install -y --no-install-recommends --allow-unauthenticated $PKGS; \
    fi && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 marks the system Python externally-managed (PEP 668), so allow the pinned
# cmake wheel to install system-wide.
RUN pip3 install --no-cache-dir --break-system-packages "cmake==3.31.6"

COPY common/build_ort.sh /work/build_ort.sh
COPY VERSIONS.env /work/VERSIONS.env
RUN chmod +x /work/build_ort.sh

# GPU = default device, graph partitioning on (unsupported ops fall back to the
# ORT CPU EP). The app overrides device_type (CPU/NPU/AUTO) at runtime; all
# plugins load dynamically. Valid build values: CPU|GPU|NPU, *_NO_PARTITION,
# NPU_NO_CPU_FALLBACK, AUTO:GPU,CPU, MULTI:..., HETERO:... (plain AUTO is invalid).
ENV ORT_VERSION=${ORT_VERSION} \
    ORT_GROUP=openvino \
    ORT_EP_FLAGS="--use_openvino GPU --use_xnnpack"

WORKDIR /src
ENTRYPOINT ["bash", "-lc", "source /opt/intel/openvino/setupvars.sh && exec /work/build_ort.sh"]
