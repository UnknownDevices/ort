# NVIDIA "NV TensorRT RTX" execution provider build (x86_64).
#
# IMPORTANT: ORT v1.22.0's nv_tensorrt_rtx provider (cmake/onnxruntime_providers_nv.cmake)
# builds against REGULAR TensorRT 10.x -- it find_library()s nvinfer/nvonnxparser
# and parses NV_TENSORRT_MAJOR (>=10) from NvInferVersion.h under
# onnxruntime_TENSORRT_HOME. It has NO support for the standalone TensorRT-RTX SDK
# (libtensorrt_rtx / the --tensorrt_rtx_home flag); that arrived in a later ORT.
# So this group links the full TensorRT 10.8 already in the nvcr base image at
# /usr, exactly like cuda-trt -- the only difference is the (newer) provider
# source, not the runtime. Shipping the lightweight TensorRT-RTX runtime instead
# would require bumping ORT to >=1.23 (and the fork's C-API ABI off ms@1.22.0).
ARG NV_TENSORRT_IMAGE=nvcr.io/nvidia/tensorrt:25.01-py3
FROM ${NV_TENSORRT_IMAGE}

ARG ORT_VERSION=v1.22.0
ENV DEBIAN_FRONTEND=noninteractive

# Clean authenticated install first; fall back to tolerant flags if the image's
# CUDA apt repo has a stale key / Release. (curl is used by build_ort.sh's
# GitLab dep-hash self-heal.)
RUN PKGS="git ninja-build ccache patchelf ca-certificates curl"; \
    if ! { apt-get update && apt-get install -y --no-install-recommends $PKGS; }; then \
       apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::AllowInsecureRepositories=true && \
       apt-get install -y --no-install-recommends --allow-unauthenticated $PKGS; \
    fi && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "cmake==3.31.6"

COPY common/build_ort.sh /work/build_ort.sh
COPY VERSIONS.env /work/VERSIONS.env
RUN chmod +x /work/build_ort.sh

ENV ORT_VERSION=${ORT_VERSION} \
    ORT_GROUP=nv-trt-rtx \
    ORT_EP_FLAGS="--use_cuda --cuda_home /usr/local/cuda --cudnn_home /usr --use_nv_tensorrt_rtx --tensorrt_home /usr --use_xnnpack"

WORKDIR /src
ENTRYPOINT ["/work/build_ort.sh"]
