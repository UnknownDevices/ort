# AMD ROCm + MIGraphX build (x86_64).
ARG ROCM_IMAGE=rocm/dev-ubuntu-22.04:6.2.4-complete
FROM ${ROCM_IMAGE}

ARG ORT_VERSION=v1.22.0
ENV DEBIAN_FRONTEND=noninteractive

# The -complete image already has all of ROCm; drop its AMD/ROCm apt sources
# (rotated key / stale Release metadata break apt-get update — not needed). Try
# a clean authenticated install of Ubuntu build tools, fall back to tolerant
# flags only if the base repos are unhealthy too.
RUN rm -f /etc/apt/sources.list.d/*rocm* /etc/apt/sources.list.d/*radeon* \
          /etc/apt/sources.list.d/*amdgpu* 2>/dev/null || true; \
    PKGS="git python3 python3-pip python3-dev build-essential ninja-build ccache curl ca-certificates patchelf"; \
    if ! { apt-get update && apt-get install -y --no-install-recommends $PKGS; }; then \
       apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::AllowInsecureRepositories=true && \
       apt-get install -y --no-install-recommends --allow-unauthenticated $PKGS; \
    fi && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "cmake==3.31.6"

COPY common/build_ort.sh /work/build_ort.sh
COPY VERSIONS.env /work/VERSIONS.env
RUN chmod +x /work/build_ort.sh

ENV ORT_VERSION=${ORT_VERSION} \
    ORT_GROUP=rocm \
    ORT_EP_FLAGS="--use_rocm --rocm_home /opt/rocm --use_migraphx --migraphx_home /opt/rocm --use_xnnpack"

WORKDIR /src
ENTRYPOINT ["/work/build_ort.sh"]
