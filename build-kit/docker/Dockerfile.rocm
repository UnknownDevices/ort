# AMD ROCm + MIGraphX build (x86_64).
ARG ROCM_IMAGE=rocm/dev-ubuntu-22.04:6.2.4-complete
FROM ${ROCM_IMAGE}

ARG ORT_VERSION=v1.22.0
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 python3-pip python3-dev build-essential ninja-build \
      ccache curl ca-certificates patchelf \
   && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir "cmake==3.31.6"

COPY common/build_ort.sh /work/build_ort.sh
COPY VERSIONS.env /work/VERSIONS.env
RUN chmod +x /work/build_ort.sh

ENV ORT_VERSION=${ORT_VERSION} \
    ORT_GROUP=rocm \
    ORT_EP_FLAGS="--use_rocm --rocm_home /opt/rocm --use_migraphx --migraphx_home /opt/rocm --use_xnnpack"

WORKDIR /src
ENTRYPOINT ["/work/build_ort.sh"]
