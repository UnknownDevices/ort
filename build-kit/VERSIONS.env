# Versions and knobs for the build kit. Override any from the environment.

# ONNX Runtime built from source for every EP group, unified on 1.23.2 across all
# platforms (matches the Windows/Intel side) — AMD is no longer a 1.22 exception.
# The fork's prebuilt-ABI pin (ort-sys/dist.txt -> ms@1.22.0) only governs *downloaded*
# binaries; building from source + the rc.10 Rust bindings links fine against the newer
# 1.23.2 runtime (ORT's C API is backward-compatible). 1.23.2 is also the floor for the
# nv-trt-rtx provider to link the lightweight TensorRT-RTX SDK (libtensorrt_rtx) instead
# of full TensorRT.
# NOTE: ORT 1.23 REMOVED the ROCm execution provider; AMD now goes through the
# MIGraphX EP (see Dockerfile.rocm), the only AMD path that reaches RDNA4.
: "${ORT_VERSION:=v1.23.2}"

# Base images. Vendor-runtime majors must match what the app bundles.
# ROCm 7.2.x covers RDNA2..RDNA4 (gfx906..gfx1201) via MIGraphX — required for
# RX 9000/RDNA4; pinned to the Ubuntu 22.04 image to keep glibc 2.35 so the
# bundled ORT libs stay portable. OpenVINO 2025.x, CUDA 12.9.x (the TensorRT-RTX 1.3 SDK is cuda-12.9).
: "${ROCM_IMAGE:=rocm/dev-ubuntu-22.04:7.2.4-complete}"
: "${OPENVINO_IMAGE:=openvino/ubuntu24_dev:2025.1.0}"  # OpenVINO >=2025.0 (ORT 1.23); ubuntu24 for GCC 13 + binutils 2.42 (the EP's C++20 <format> + MLAS AVX-NE-CONVERT). Only group on 24.04 -> Intel glibc floor 2.39.
: "${NV_TENSORRT_IMAGE:=nvcr.io/nvidia/tensorrt:25.06-py3}"  # cuda-trt's full TensorRT base (TRT 10.11 + CUDA 12.9.1). nv-trt-rtx does NOT use this; see below.
# nv-trt-rtx builds against the standalone TensorRT-RTX SDK, not full TensorRT, so it bases
# on a CUDA-only image (no full-TRT headers to hijack cmake's NvInfer.h probe) and links
# the SDK you vendor into build-kit/vendor/ (auth-gated NVIDIA download).
: "${NV_RTX_CUDA_IMAGE:=nvidia/cuda:12.9.1-cudnn-devel-ubuntu22.04}"
: "${TENSORRT_RTX_VERSION:=1.3.0.35}"   # informational; matches the vendored tarball / Windows tensorrt_rtx_1_3
: "${CPU_IMAGE:=ubuntu:22.04}"

: "${NPROC:=}"                 # empty -> nproc (build parallelism)
: "${NVCC_THREADS:=}"          # opt-in: threads per nvcc for the CUDA groups
: "${ORT_ENABLE_LTO:=1}"       # release LTO for non-CUDA groups (CMake 3.31+GCC -flto=auto, parallel link)
# NVIDIA-group overrides (wired into the cuda-trt / nv-trt-rtx build_group calls).
# Device-LTO defers every per-arch ptxas pass into one single-threaded nvlink,
# which serializes the whole multi-arch build onto a single core (the 18h grind)
# and is the OOM source -- so LTO is OFF here. The ptxas passes are also memory
# hungry, so parallelism is bounded: ~CUDA_NPROC*CUDA_NVCC_THREADS concurrent
# ptxas at ~2-5 GB each. Raise CUDA_NPROC on big-RAM boxes after watching peak RSS.
: "${CUDA_ENABLE_LTO:=0}"
: "${CUDA_NPROC:=64}"
: "${CUDA_NVCC_THREADS:=2}"
: "${CCACHE_DIR_HOST:=cache/ccache}"  # host path -> persist ccache across runs (on by default; speeds re-runs)
# Empty -> build trees + compiler temp files live in the container overlay (Docker data-root).
# Set to a path on a roomier disk (e.g. /mnt/temp-storage) to mount it over the container's
# /tmp, so the multi-GB BUILD_DIR and gcc's temp .s files land there instead (the cuda-trt
# build wants tens of GB). If ccache is also on a small disk, point CCACHE_DIR_HOST there too.
: "${BUILD_STORAGE_DIR:=/mnt/temp-storage}"
: "${ORT_CUDA_ARCHS:=}"        # default set per-box in the orchestrators
: "${ORT_ROCM_GFX:=}"          # default set in build-amd64.sh; bounded by ROCM_IMAGE MIOpen
: "${ORT_EXTRA_FLAGS:=}"

export ORT_VERSION ROCM_IMAGE OPENVINO_IMAGE NV_TENSORRT_IMAGE NV_RTX_CUDA_IMAGE TENSORRT_RTX_VERSION CPU_IMAGE \
       NPROC NVCC_THREADS ORT_ENABLE_LTO CCACHE_DIR_HOST BUILD_STORAGE_DIR \
       CUDA_ENABLE_LTO CUDA_NPROC CUDA_NVCC_THREADS \
       ORT_CUDA_ARCHS ORT_ROCM_GFX ORT_EXTRA_FLAGS
