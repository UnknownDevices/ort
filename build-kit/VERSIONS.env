# Versions and knobs for the build kit. Override any from the environment.

# Must match the fork's C-API ABI (ort-sys/dist.txt -> ms@1.22.0).
: "${ORT_VERSION:=v1.22.0}"

# Base images. Vendor-runtime majors must match what the app bundles
# (ROCm 6.x, OpenVINO 2024.x, CUDA 12.8+ for Blackwell sm_120).
: "${ROCM_IMAGE:=rocm/dev-ubuntu-22.04:6.2.4-complete}"
: "${OPENVINO_IMAGE:=openvino/ubuntu22_dev:2024.6.0}"
: "${NV_TENSORRT_IMAGE:=nvcr.io/nvidia/tensorrt:25.01-py3}"
: "${CPU_IMAGE:=ubuntu:22.04}"

# Linux TensorRT-RTX SDK, auto-downloaded (unauthenticated). Keep the CUDA
# suffix (12.9) consistent with NV_TENSORRT_IMAGE. Offline: stage in ./sdk/.
: "${TRT_RTX_URL:=https://developer.nvidia.com/downloads/trt/rtx_sdk/secure/1.3/TensorRT-RTX-1.3.0.35-linux-x86_64-cuda-12.9-Release-external.tar.gz}"

: "${NPROC:=}"                 # empty -> nproc
: "${ORT_ENABLE_LTO:=1}"
: "${CCACHE_DIR_HOST:=}"       # host path -> persist ccache across runs
: "${ORT_CUDA_ARCHS:=}"        # default set per-box in the orchestrators
: "${ORT_ROCM_GFX:=}"          # default set in build-amd64.sh; bounded by ROCM_IMAGE MIOpen
: "${ORT_EXTRA_FLAGS:=}"

export ORT_VERSION ROCM_IMAGE OPENVINO_IMAGE NV_TENSORRT_IMAGE CPU_IMAGE \
       TRT_RTX_URL NPROC ORT_ENABLE_LTO CCACHE_DIR_HOST ORT_CUDA_ARCHS \
       ORT_ROCM_GFX ORT_EXTRA_FLAGS
