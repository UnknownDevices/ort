# Versions and knobs for the build kit. Override any from the environment.

# Built from source. The fork's prebuilts are ms@1.22.0 (ort-sys/dist.txt), but ORT's C
# API is backward-compatible, so the rc.10 bindings link fine against a newer runtime.
# 1.23.2 matches the Windows side and is the floor for the nv-trt-rtx provider to link the
# lightweight TensorRT-RTX SDK (libtensorrt_rtx) instead of full TensorRT.
: "${ORT_VERSION:=v1.23.2}"
# Exception: the rocm group stays on 1.22 -- ONNX Runtime DELETED the ROCm EP in 1.23
# (MIGraphX-only there). Per-vendor bundles are independent, so AMD keeps the ROCm EP at the
# last version that shipped it while the other groups move to 1.23.2 (see build-amd64.sh).
: "${ROCM_ORT_VERSION:=v1.22.0}"

# Base images. Vendor-runtime majors must match what the app bundles
# (ROCm 6.x, OpenVINO 2025.x, CUDA 12.9.x — the TensorRT-RTX 1.3 SDK is cuda-12.9).
: "${ROCM_IMAGE:=rocm/dev-ubuntu-22.04:6.2.4-complete}"
: "${OPENVINO_IMAGE:=openvino/ubuntu22_dev:2025.1.0}"  # ORT 1.23's OpenVINO EP requires >=2025.0
: "${NV_TENSORRT_IMAGE:=nvcr.io/nvidia/tensorrt:25.06-py3}"  # cuda-trt's full TensorRT base (TRT 10.11 + CUDA 12.9.1). nv-trt-rtx does NOT use this; see below.
# nv-trt-rtx builds against the standalone TensorRT-RTX SDK, not full TensorRT, so it bases
# on a CUDA-only image (no full-TRT headers to hijack cmake's NvInfer.h probe) and links
# the SDK you vendor into build-kit/vendor/ (auth-gated NVIDIA download).
: "${NV_RTX_CUDA_IMAGE:=nvidia/cuda:12.9.1-cudnn-devel-ubuntu22.04}"
: "${TENSORRT_RTX_VERSION:=1.3.0.35}"   # informational; matches the vendored tarball / Windows tensorrt_rtx_1_3
: "${CPU_IMAGE:=ubuntu:22.04}"

: "${NPROC:=}"                 # empty -> nproc (build parallelism)
: "${NVCC_THREADS:=}"          # opt-in: threads per nvcc for the CUDA groups
: "${ORT_ENABLE_LTO:=1}"       # release LTO for non-CUDA groups (CMake 3.31+GCC -flto=auto, parallel link)
# NVIDIA-group overrides (wired into the cuda-trt / nv-trt-rtx build_group calls).
# Device-LTO defers every per-arch ptxas pass into one single-threaded nvlink,
# which serializes the whole multi-arch build onto a single core (the 18h grind)
# and is the OOM source -- so LTO is OFF here. The ptxas passes are also memory
# hungry, so parallelism is bounded: ~CUDA_NPROC*CUDA_NVCC_THREADS concurrent
# ptxas at ~2-5 GB each. Raise CUDA_NPROC on big-RAM boxes after watching peak RSS.
: "${CUDA_ENABLE_LTO:=0}"
: "${CUDA_NPROC:=64}"
: "${CUDA_NVCC_THREADS:=2}"
: "${CCACHE_DIR_HOST:=cache/ccache}"  # host path -> persist ccache across runs (on by default; speeds re-runs)
: "${ORT_CUDA_ARCHS:=}"        # default set per-box in the orchestrators
: "${ORT_ROCM_GFX:=}"          # default set in build-amd64.sh; bounded by ROCM_IMAGE MIOpen
: "${ORT_EXTRA_FLAGS:=}"

export ORT_VERSION ROCM_ORT_VERSION ROCM_IMAGE OPENVINO_IMAGE NV_TENSORRT_IMAGE NV_RTX_CUDA_IMAGE TENSORRT_RTX_VERSION CPU_IMAGE \
       NPROC NVCC_THREADS ORT_ENABLE_LTO CCACHE_DIR_HOST \
       CUDA_ENABLE_LTO CUDA_NPROC CUDA_NVCC_THREADS \
       ORT_CUDA_ARCHS ORT_ROCM_GFX ORT_EXTRA_FLAGS
