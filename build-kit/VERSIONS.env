# Versions and knobs for the build kit. Override any from the environment.

# ONNX Runtime built from source for every EP group. Unified on 1.23.2 across
# all platforms (matches Windows/Intel) — AMD is no longer a 1.22 exception.
# NOTE: ORT 1.23 REMOVED the ROCm execution provider; AMD now goes through the
# MIGraphX EP (see Dockerfile.rocm), the only AMD path that reaches RDNA4. The
# fork's prebuilt-ABI pin (ort-sys/dist.txt -> ms@1.22.0) only governs
# downloaded binaries; building from source + the Rust crate is fine on 1.23.2.
: "${ORT_VERSION:=v1.23.2}"

# Base images. Vendor-runtime majors must match what the app bundles.
# ROCm 7.2.x covers RDNA2..RDNA4 (gfx906..gfx1201) via MIGraphX — required for
# RX 9000/RDNA4; pinned to the Ubuntu 22.04 image to keep glibc 2.35 so the
# bundled ORT libs stay portable. OpenVINO 2024.x, CUDA 12.8+ for Blackwell.
: "${ROCM_IMAGE:=rocm/dev-ubuntu-22.04:7.2.4-complete}"
: "${OPENVINO_IMAGE:=openvino/ubuntu22_dev:2024.6.0}"
: "${NV_TENSORRT_IMAGE:=nvcr.io/nvidia/tensorrt:25.01-py3}"
: "${CPU_IMAGE:=ubuntu:22.04}"

# Linux TensorRT-RTX SDK, auto-downloaded (unauthenticated). Keep the CUDA
# suffix (12.9) consistent with NV_TENSORRT_IMAGE. Offline: stage in ./sdk/.
: "${TRT_RTX_URL:=https://developer.nvidia.com/downloads/trt/rtx_sdk/secure/1.3/TensorRT-RTX-1.3.0.35-linux-x86_64-cuda-12.9-Release-external.tar.gz}"

: "${NPROC:=}"                 # empty -> nproc (build parallelism)
: "${NVCC_THREADS:=}"          # opt-in: threads per nvcc for the CUDA groups
: "${ORT_ENABLE_LTO:=1}"       # release LTO; CMake 3.31+GCC emits -flto=auto (parallel link)
: "${CCACHE_DIR_HOST:=}"       # host path -> persist ccache across runs
: "${ORT_CUDA_ARCHS:=}"        # default set per-box in the orchestrators
: "${ORT_ROCM_GFX:=}"          # default set in build-amd64.sh; bounded by ROCM_IMAGE MIOpen
: "${ORT_EXTRA_FLAGS:=}"

export ORT_VERSION ROCM_IMAGE OPENVINO_IMAGE NV_TENSORRT_IMAGE CPU_IMAGE \
       TRT_RTX_URL NPROC NVCC_THREADS ORT_ENABLE_LTO CCACHE_DIR_HOST \
       ORT_CUDA_ARCHS ORT_ROCM_GFX ORT_EXTRA_FLAGS
